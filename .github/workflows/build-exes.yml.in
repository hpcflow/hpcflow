name: build-exes

env:
  PYTHON_VERSION_BUILD_EXES: "3.12"
  POETRY_VERSION: "1.4"

on:
  workflow_dispatch:
    inputs:
      build_linux:
        description: "Build executables for linux?"
        required: true
        type: boolean
        default: true
      build_macos:
        description: "Build executables for macOS?"
        required: true
        type: boolean
        default: true
      build_windows:
        description: "Build executables for Windows?"
        required: true
        type: boolean
        default: true
      build_onedir:
        description: "Build one-dir?"
        required: true
        type: boolean
        default: true
      build_onefile:
        description: "Build one-file?"
        required: true
        type: boolean
        default: true
      logLevel:
        description: "PyInstaller log level"
        required: true
        default: "INFO"
      unit_test_args:
        description: "CLI args to pass verbatim to pytest (unit tests)."
        required: false
        type: string
        default: ""

jobs:
  status:
    runs-on: ubuntu-latest # Fastest and cheapest
    outputs:
{% raw %}
      version: ${{ steps.info.outputs.vers }}
      sha: ${{ steps.info.outputs.sha }}
{% endraw %}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0 # get all history and tags
      - name: Get executable version name and store git SHA
        id: info
        run: |
          CUR_TAG=$(git describe --tags $(git rev-list --tags --max-count=1))
          echo "CUR_TAG is: $CUR_TAG"
          echo "cur_tag=$CUR_TAG" >> $GITHUB_OUTPUT
          vers=$(git describe --tags)
          echo "vers is: $vers"
          echo "vers=$vers" >> $GITHUB_OUTPUT
          sha=$(git rev-parse HEAD)
          echo "sha is: $sha"
          echo "sha=$sha" >> $GITHUB_OUTPUT

  build-windows-executables:
    if: github.event.inputs.build_windows == 'true'
    needs: status
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: {% raw %}${{ env.PYTHON_VERSION_BUILD_EXES }}{% endraw %}
      - uses: ./.github/actions/init-cache
        with:
          name: build-exe
          version: {% raw %}${{ env.PYTHON_VERSION_BUILD_EXES }}{% endraw %}

      - uses: ./.github/actions/setup-poetry
        with:
          version: {% raw %}${{ env.POETRY_VERSION }}{% endraw %}

      - name: Install dependencies
        run: poetry install --without dev

      - name: Build with pyinstaller for Windows (file)
        if: github.event.inputs.build_onefile == 'true'
        working-directory: {{ pyinstaller_dir }}
        run: ./make.ps1 -ExeName "{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}-win" -LogLevel ${{ github.event.inputs.logLevel }}{% endraw %} -BuildType 'onefile'

      - name: Build with pyinstaller for Windows (folder)
        if: github.event.inputs.build_onedir == 'true'
        working-directory: {{ pyinstaller_dir }}
        run: ./make.ps1 -ExeName "{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}-win-dir" -LogLevel ${{ github.event.inputs.logLevel }}{% endraw %} -BuildType 'onedir'

      - name: Upload executable artifact (file)
        if: github.event.inputs.build_onefile == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win.exe
          path: {{ pyinstaller_dir }}/dist/onefile/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win.exe

      - name: Upload executable artifact (folder)
        if: github.event.inputs.build_onedir == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win-dir
          path: {{ pyinstaller_dir }}/dist/onedir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win-dir

      - name: Upload spec file
        if: (github.event.inputs.build_onefile == 'true' || github.event.inputs.build_onedir == 'true')
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win.spec
          path: {{ pyinstaller_dir }}/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win.spec

      - name: Upload build directory
        if: (github.event.inputs.build_onefile == 'true' || github.event.inputs.build_onedir == 'true')
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win-build
          path: {{ pyinstaller_dir }}/build/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win

      - name: Set demo data GitHub URL using current git SHA (file) # instead of default which is current version tag
        if: github.event.inputs.build_onefile == 'true'
        run: |
          {{ pyinstaller_dir }}/dist/onefile/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win.exe config set-github-demo-data-dir {% raw %}${{ needs.status.outputs.sha }}{% endraw %}

      - name: Set demo data GitHub URL using current git SHA (folder) # instead of default which is current version tag
        if: github.event.inputs.build_onedir == 'true'
        run: |
          {{ pyinstaller_dir }}/dist/onedir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win-dir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win-dir.exe config set-github-demo-data-dir {% raw %}${{ needs.status.outputs.sha }}{% endraw %}

      - name: Run test suite on the frozen app (file)
        if: github.event.inputs.build_onefile == 'true'
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          {{ pyinstaller_dir }}/dist/onefile/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win.exe test {% raw %}${{ github.event.inputs.unit_test_args }}{% endraw %}

      - name: Run test suite on the frozen app (folder)
        if: github.event.inputs.build_onedir == 'true'
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          {{ pyinstaller_dir }}/dist/onedir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win-dir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-win-dir.exe test {% raw %}${{ github.event.inputs.unit_test_args }}{% endraw %}


  build-macos-executables:
    if: github.event.inputs.build_macos == 'true'
    needs: status
    runs-on: macos-13
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: {% raw %}${{ env.PYTHON_VERSION_BUILD_EXES }}{% endraw %}
      - uses: ./.github/actions/init-cache
        with:
          name: build-exe
          version: {% raw %}${{ env.PYTHON_VERSION_BUILD_EXES }}{% endraw %}
      - uses: ./.github/actions/setup-poetry
        with:
          version: ${{ env.POETRY_VERSION }}

      - name: Install dependencies
        run: poetry install --without dev

      - name: Build with pyinstaller for macOS (file)
        if: github.event.inputs.build_onefile == 'true'
        working-directory: {{ pyinstaller_dir }}
        run: ./make.sh {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}-macOS ${{ github.event.inputs.logLevel }}{% endraw %} 'onefile'

      - name: Build with pyinstaller for macOS (folder)
        if: github.event.inputs.build_onedir == 'true'
        working-directory: {{ pyinstaller_dir }}
        run: ./make.sh {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}-macOS-dir ${{ github.event.inputs.logLevel }}{% endraw %} 'onedir'

      - name: Upload executable artifact (file)
        if: github.event.inputs.build_onefile == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS
          path: {{ pyinstaller_dir }}/dist/onefile/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS

      - name: Upload executable artifact (folder)
        if: github.event.inputs.build_onedir == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS-dir
          path: {{ pyinstaller_dir }}/dist/onedir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS-dir

      - name: Upload spec file
        if: (github.event.inputs.build_onefile == 'true' || github.event.inputs.build_onedir == 'true')
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS.spec
          path: {{ pyinstaller_dir }}/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS.spec

      - name: Upload build directory
        if: (github.event.inputs.build_onefile == 'true' || github.event.inputs.build_onedir == 'true')
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS-build
          path: {{ pyinstaller_dir }}/build/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS

      - name: Set demo data GitHub URL using current git SHA (file) # instead of default which is current version tag
        if: github.event.inputs.build_onefile == 'true'
        run: |
          {{ pyinstaller_dir }}/dist/onefile/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS config set-github-demo-data-dir {% raw %}${{ needs.status.outputs.sha }}{% endraw %}

      - name: Set demo data GitHub URL using current git SHA (folder) # instead of default which is current version tag
        if: github.event.inputs.build_onedir == 'true'
        run: |
          {{ pyinstaller_dir }}/dist/onedir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS-dir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS-dir config set-github-demo-data-dir {% raw %}${{ needs.status.outputs.sha }}{% endraw %}

      - name: Run test suite on the frozen app (file)
        if: github.event.inputs.build_onefile == 'true'
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          {{ pyinstaller_dir }}/dist/onefile/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS test {% raw %}${{ github.event.inputs.unit_test_args }}{% endraw %}

      - name: Run test suite on the frozen app (folder)
        if: github.event.inputs.build_onedir == 'true'
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          {{ pyinstaller_dir }}/dist/onedir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS-dir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-macOS-dir test {% raw %}${{ github.event.inputs.unit_test_args }}{% endraw %}

  build-executables-linux:
    if: github.event.inputs.build_linux == 'true'
    needs: status
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/init-cache
        with:
          name: build-exe
          version: {% raw %}${{ env.PYTHON_VERSION_BUILD_EXES }}{% endraw %}

      - name: Build executable (file) within Docker
        if: github.event.inputs.build_onefile == 'true'
        uses: addnab/docker-run-action@v3
        with:
          image: ghcr.io/hpcflow/centos7-poetry:latest
          options: -v {% raw %}${{ github.workspace }}:/home --env GH_TOKEN=${{ secrets.GITHUB_TOKEN }}{% endraw %}
          run: |

            # set up poetry
            cd /home
            poetry config virtualenvs.in-project true
            poetry config installer.modern-installation false
            poetry install --without dev

            # build with pyinstaller for CentOS (file)
            cd {{ pyinstaller_dir }}
            ./make.sh {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}-linux ${{ github.event.inputs.logLevel }}{% endraw %} onefile
            cd ..

            # set demo data GitHub URL using current git SHA (file), instead of default which is current version tag
            {{ pyinstaller_dir }}/dist/onefile/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}-linux config set-github-demo-data-dir ${{ needs.status.outputs.sha }}{% endraw %}

            # run test suite on the frozen app (file)
            {{ pyinstaller_dir }}/dist/onefile/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}-linux test ${{ github.event.inputs.unit_test_args }}{% endraw %}

      - name: Build executable (folder) within Docker
        if: github.event.inputs.build_onedir == 'true'
        uses: addnab/docker-run-action@v3
        with:
          image: ghcr.io/hpcflow/centos7-poetry:latest
          options: -v {% raw %}${{ github.workspace }}:/home --env GH_TOKEN=${{ secrets.GITHUB_TOKEN }}{% endraw %}
          run: |

            # set up poetry
            cd /home
            poetry config virtualenvs.in-project true
            poetry config installer.modern-installation false
            poetry install --without dev

            # build with pyinstaller for CentOS (folder)
            cd {{ pyinstaller_dir }}
            ./make.sh {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}-linux-dir ${{ github.event.inputs.logLevel }}{% endraw %} onedir
            cd ..

            # set demo data GitHub URL using current git SHA (folder), instead of default which is current version tag
            {{ pyinstaller_dir }}/dist/onedir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux-dir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux-dir config set-github-demo-data-dir {% raw %}${{ needs.status.outputs.sha }}{% endraw %}

            # run test suite on the frozen app (folder)
            {{ pyinstaller_dir }}/dist/onedir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux-dir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux-dir test {% raw %}${{ github.event.inputs.unit_test_args }}{% endraw %}

      - name: Upload executable artifact (file)
        if: github.event.inputs.build_onefile == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux
          path: {{ pyinstaller_dir }}/dist/onefile/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux

      - name: Upload executable artifact (folder)
        if: github.event.inputs.build_onedir == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux-dir
          path: {{ pyinstaller_dir }}/dist/onedir/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux-dir

      - name: Upload spec file
        if: (github.event.inputs.build_onefile == 'true' || github.event.inputs.build_onedir == 'true')
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux.spec
          path: {{ pyinstaller_dir }}/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux.spec

      - name: Upload build directory
        if: (github.event.inputs.build_onefile == 'true' || github.event.inputs.build_onedir == 'true')
        uses: actions/upload-artifact@v4
        with:
          name: {{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux-build
          path: {{ pyinstaller_dir }}/build/{{ executable_name }}-{% raw %}${{ needs.status.outputs.version }}{% endraw %}-linux
